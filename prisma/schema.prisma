generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

model User {
  id                  String                @id
  name                String
  email               String                @unique
  emailVerified       Boolean               @default(false)
  image               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  accounts            Account[]
  exercices_attempts  exercices_attempts[]
  exercices_errors    exercices_errors[]
  filter_preferences  filter_preferences[]
  generated_questions generated_questions[]
  profiles            profiles[]
  sessions            Session[]
  reading_logs        reading_logs[]
  todo_completions    todo_completions[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model category {
  id    Int     @id @unique @default(autoincrement())
  name  String  @db.VarChar(100)
  slug  String  @unique(map: "categories_slug_key") @db.VarChar(100)
  topic topic[]
}

model exercices_attempts {
  id                                        Int                  @id @unique @default(autoincrement())
  user_id                                   String
  profile_id                                String               @db.Uuid
  exercise_id                               Int?
  dictation_id                              Int?
  conjugaison_id                            Int?
  generated_question_id                     Int?
  question_type                             String
  question_text                             String
  user_answer                               String?
  is_correct                                Boolean
  created_at                                DateTime?            @default(now()) @db.Timestamptz(6)
  correct_answer                            String?
  choices                                   String[]
  correction_user_answer_errors_highlighted String?
  original_text_errors_highlighted          String?
  correction_total_errors                   Int?
  correction_errors_spelling                Int?
  correction_errors_grammar                 Int?
  correction_errors_conjugation             Int?
  correction_success_percentage              Int?
  correction_greeting_message               String?
  correction_errors_by_sentence_json        Json?
  correction_conclusion_message             String?
  correction_full_json                      String?
  dictation                                 dictation?           @relation(fields: [dictation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conjugaison                               conjugaison?         @relation(fields: [conjugaison_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exercices_errors                          exercices_errors[]
  generated_questions                       generated_questions? @relation(fields: [generated_question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises                                 exercises?           @relation(fields: [exercise_id], references: [id], onUpdate: NoAction, map: "training_attempts_exercise_id_fkey")
  profiles                                  profiles             @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "training_attempts_profile_id_fkey")
  user                                      User                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "training_attempts_user_id_fkey")

  @@index([user_id, created_at], map: "idx_training_attempts_user_created")
  @@index([exercise_id], map: "idx_training_attempts_exercise")
  @@index([profile_id, created_at], map: "idx_training_attempts_profile_created")
  @@index([dictation_id, profile_id])
  @@index([dictation_id, created_at])
  @@index([profile_id, dictation_id, created_at])
  @@index([conjugaison_id, profile_id])
  @@index([profile_id, conjugaison_id, created_at])
}

model conjugaison {
  id             Int      @id @default(autoincrement())
  infinitif      String
  groupe         Int
  personne       String
  temps          String
  verbe_conjugue String
  radical        String
  terminaison    String
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  exercices_attempts exercices_attempts[]

  @@unique([infinitif, temps, personne])
  @@index([infinitif])
}



model exercise_levels {
  exercise_id Int
  level_id    Int
  id          Int       @id @default(autoincrement())
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels      levels    @relation(fields: [level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exercises {
  id                        Int                   @id @default(autoincrement())
  title                     String                @db.VarChar(200)
  rules_text                String
  examples_text             String
  supports_multiple_choices Boolean?              @default(true)
  supports_text_choice      Boolean?              @default(true)
  created_at                DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?             @default(now()) @db.Timestamptz(6)
  question                  String?
  question_example          String?
  expected_answer           String?
  answer_example            String?
  answer_choices_example    String[]
  supports_single_choice    Boolean?
  topic_id                  Int
  exercices_attempts        exercices_attempts[]
  exercise_levels           exercise_levels[]
  topic                     topic                 @relation(fields: [topic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generated_questions       generated_questions[]
}

model filter_preferences {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String
  profile_id            String?        @db.Uuid
  selected_category_ids Int[]          @default([])
  question_type         question_type?
  show_rules_default    Boolean?       @default(false)
  created_at            DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?      @default(now()) @db.Timestamptz(6)
  selected_topic_ids    Int[]          @default([])
  user                  User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, profile_id], map: "idx_filter_preferences_user_profile")
}

model generated_questions {
  id                    Int                  @id @default(autoincrement())
  user_id               String?
  profile_id            String               @db.Uuid
  exercise_id           Int
  payload               Json
  model_name            String?              @db.VarChar(100)
  llm_latency_ms        Int?
  created_at            DateTime?            @default(now()) @db.Timestamptz(6)
  instruction           String?
  encouragement_message String?
  choices               String[]
  correct_answer        String?
  rules_explanation     String?
  success_message       String?
  error_message         String?
  is_used               Boolean?             @default(false)
  status                String?              @default("TO_SOLVE")
  exercices_attempts    exercices_attempts[]
  exercises             exercises            @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles              profiles             @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model levels {
  id                Int                 @id @default(autoincrement())
  code              String              @unique @db.VarChar(10)
  label             String              @db.VarChar(100)
  rank              Int
  dictations_levels dictations_levels[]
  exercise_levels   exercise_levels[]
  profile_levels    profile_levels[]
  topics_levels     topics_levels[]
}

model profile_levels {
  profile_id String   @db.Uuid
  level_id   Int
  id         Int      @id @unique @default(autoincrement())
  levels     levels   @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles   profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profiles {
  id                  String                @id @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String
  first_name          String                @db.VarChar(100)
  last_name           String?               @db.VarChar(100)
  avatar_url          String?
  age                 Int?
  description         String?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  active_book_id      Int?
  active_book_id_2    Int?
  weekly_pages_goal   Int?
  conjugaison_show_radical Boolean @default(true)
  conjugaison_groupes      Int[]   @default([1, 2, 3])
  exercices_attempts  exercices_attempts[]
  exercices_errors    exercices_errors[]
  generated_questions generated_questions[]
  profile_levels      profile_levels[]
  favorite_dictations favorite_dictations_profiles[]
  books               books[]
  reading_logs        reading_logs[]
  weekly_payments     weekly_payments[]
  todos               todos[]
  todo_categories     todo_categories[]
  todo_completions    todo_completions[]
  active_book         books?                @relation("active_book", fields: [active_book_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  active_book_2       books?                @relation("active_book_2", fields: [active_book_id_2], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model topic {
  id                        Int              @id @unique @default(autoincrement())
  category_id               Int
  name                      String          @db.VarChar(100)
  slug                      String          @unique
  rules_explanation_message String?
  dictation                 dictation[]
  exercises                 exercises[]
  category                  category        @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topics_levels             topics_levels[]

  @@index([category_id])
}

model topics_levels {
  id         Int      @id @unique @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  topic_id   Int
  level_id   Int
  levels     levels   @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic      topic    @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model dictation {
  id                 Int                  @id @unique @default(autoincrement())
  topic_id           Int
  title              String
  original_text      String
  audio_file         String?
  screenshot_file    String?
  picture_file       String?
  count_words        Int?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  topic              topic                @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dictations_levels  dictations_levels[]
  exercices_attempts exercices_attempts[]
  exercices_errors   exercices_errors[]
  dictation_sentences dictation_sentence[]
  favorite_profiles   favorite_dictations_profiles[]

  @@index([topic_id])
}

model favorite_dictations_profiles {
  id           Int        @id @default(autoincrement())
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  profile_id   String     @db.Uuid
  dictation_id Int

  profiles  profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dictation dictation @relation(fields: [dictation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile_id, dictation_id])
  @@index([dictation_id])
  @@map("favorite_dictations_profiles")
}

model dictations_levels {
  id           Int       @id @unique @default(autoincrement())
  level_id     Int
  dictation_id Int
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  dictation    dictation @relation(fields: [dictation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels       levels    @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dictation_id])
  @@index([level_id, dictation_id])
  @@index([level_id]) // Added for filtering by level_id
}

model dictation_sentence {
  id           Int       @id @unique @default(autoincrement())
  text         String
  order        Int?
  audio_file   String?
  dictation_id Int
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  dictation    dictation @relation(fields: [dictation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dictation_id])
}

model exercices_errors {
  id           Int       @id @default(autoincrement())
  user_id      String
  profile_id   String    @db.Uuid
  attempt_id   Int
  dictation_id Int
  wrong_text   String
  right_text   String
  error_type   String
  explication  String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  
  user               User              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles           profiles          @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercices_attempts exercices_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dictation          dictation         @relation(fields: [dictation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  @@index([attempt_id])
  @@index([dictation_id])
  @@index([profile_id])
}

enum question_type {
  QCM
  LIBRE
  DICTEE
}

model books {
  id                    Int            @id @default(autoincrement())
  profile_id            String         @db.Uuid
  title                 String         @db.VarChar(200)
  start_page            Int            @default(0)
  remuneration_per_page Decimal?       @db.Decimal(10, 2)
  currency              String?        @db.VarChar(3)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  profiles     profiles       @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reading_logs reading_logs[]
  active_for   profiles[]     @relation("active_book")
  active_for_2 profiles[]     @relation("active_book_2")

  @@index([profile_id])
}

model weekly_payments {
  id          Int      @id @default(autoincrement())
  profile_id  String   @db.Uuid
  week_sunday DateTime @db.Date
  amount_paid Decimal  @db.Decimal(10, 2)
  currency    String?  @db.VarChar(3)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profiles profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile_id, week_sunday])
  @@index([profile_id, week_sunday])
}

model reading_logs {
  id               Int       @id @default(autoincrement())
  user_id          String
  profile_id       String    @db.Uuid
  book_id          Int
  read_date        DateTime  @db.Date
  page_number      Int
  pages_read_count Int
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user     User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book     books    @relation(fields: [book_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([profile_id, book_id, read_date])
  @@index([profile_id, read_date])
  @@index([book_id])
}

model todo_categories {
  id         Int      @id @default(autoincrement())
  profile_id String   @db.Uuid
  name       String   @db.VarChar(100)
  icon       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  profiles profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  todos    todos[]

  @@index([profile_id])
}

model todos {
  id           Int       @id @default(autoincrement())
  profile_id   String    @db.Uuid
  category_id  Int?
  name         String    @db.VarChar(200)
  unit         String    @db.VarChar(50)
  target_value Decimal   @db.Decimal(10, 2)
  icon         String?
  position     Int       @default(0)
  start_date   DateTime? @db.Date
  end_date     DateTime? @db.Date
  archived     Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  profiles    profiles          @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category    todo_categories?  @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  completions todo_completions[]

  @@index([profile_id, archived])
}

model todo_completions {
  id              Int      @id @default(autoincrement())
  todo_id         Int
  profile_id      String   @db.Uuid
  user_id         String
  completion_date DateTime @db.Date
  completed_at    DateTime @default(now()) @db.Timestamptz(6)
  actual_value    Decimal? @db.Decimal(10, 2)
  satisfaction    Int?
  duration_seconds Int?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  todo     todos    @relation(fields: [todo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([todo_id, completion_date])
  @@index([profile_id, completion_date])
}
